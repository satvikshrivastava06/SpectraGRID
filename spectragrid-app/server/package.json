{
    "name": "spectragrid-backend",
    "version": "1.0.0",
    "description": "Express/TypeScript server for SpectraGRID Mission Control",
    "main": "src/index.ts",
    "scripts": {
        "start": "ts-node src/index.ts",
        "start:prod": "node dist/index.js",
        "build": "tsc --project tsconfig.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/data',{recursive:true});fs.copyFileSync('src/data/db.json','dist/data/db.json');\"",
        "dev": "nodemon --watch src/**/*.ts --exec ts-node src/index.ts",
        "test": "ts-node --transpile-only test/api.test.ts && ts-node --transpile-only test/security.test.ts",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:seed": "ts-node prisma/seed.ts",
        "db:studio": "prisma studio"
    },
    "dependencies": {
        "@prisma/client": "^7.9.0",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^8.6.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "prisma": "^7.9.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.12.7",
        "nodemon": "^3.1.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.4.5"
    }
}